NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/chathub?retryWrites=true&w=majority
ACCESS_TOKEN_SECRET=your_super_secret_access_token_key_min_256_bits
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_min_256_bits
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLIENT_URL=http://localhost:5173
BCRYPT_ROUNDS=12
