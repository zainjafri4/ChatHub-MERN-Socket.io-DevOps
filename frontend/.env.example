# ─────────────────────────────────────────────────────────────
#  ChatHub Frontend — Environment Variables
#
#  Copy this file to .env for local development:
#    cp .env.example .env
#
#  IMPORTANT: Only variables prefixed with VITE_ are exposed
#  to the browser bundle. Never put secrets here.
#
#  Vite bakes these values into the compiled bundle at build
#  time (not runtime). For Docker, pass them as build args:
#    docker build --build-arg VITE_API_URL=https://api.chathub.com/api .
# ─────────────────────────────────────────────────────────────

# Backend REST API base URL (include /api suffix)
# Local:      http://localhost:5000/api
# Production: https://api.yourdomain.com/api
VITE_API_URL=http://localhost:5000/api

# Socket.io server URL (root of the backend, no /api suffix)
# Local:      http://localhost:5000
# Production: https://api.yourdomain.com
VITE_SOCKET_URL=http://localhost:5000
